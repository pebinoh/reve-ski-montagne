# Base de données Postgres. En local : `docker compose up -d` puis utiliser cette URL.
# En prod (Vercel) : URL fournie par Vercel Postgres/Neon ou équivalent.
DATABASE_URL="postgresql://postgres:devpass@localhost:5433/reveski"

# Mot de passe de l'espace privé de la monitrice
ADMIN_PASSWORD="change-me"

# Secret utilisé pour signer les sessions de l'espace privé (générer une longue chaîne aléatoire)
SESSION_SECRET="change-me-too"

# Identifiants OAuth Google (Google Cloud Console > API Calendar > identifiants OAuth "Application Web")
# Ajouter ces URI de redirection autorisées dans Google Cloud :
#   http://localhost:3000/admin/google/callback
#   https://<votre-domaine>/admin/google/callback
GOOGLE_CLIENT_ID="change-me"
GOOGLE_CLIENT_SECRET="change-me"

# Envoi des factures par email (resend.com > API Keys). Nécessite de valider
# un domaine d'envoi (ou d'utiliser le domaine de test fourni par Resend).
RESEND_API_KEY="change-me"
RESEND_FROM_EMAIL="factures@votre-domaine.fr"

# Notifications push (PWA). Générer une paire de clés avec :
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="change-me"
VAPID_PRIVATE_KEY="change-me"
VAPID_SUBJECT="mailto:contact@reve-ski.com"
