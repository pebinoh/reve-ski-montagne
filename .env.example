# Base de données (SQLite en local ; passer à une URL Postgres avant le déploiement Vercel)
DATABASE_URL="file:./dev.db"

# Mot de passe de l'espace privé de la monitrice
ADMIN_PASSWORD="change-me"

# Secret utilisé pour signer les sessions de l'espace privé (générer une longue chaîne aléatoire)
SESSION_SECRET="change-me-too"
