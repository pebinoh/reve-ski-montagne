generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Carnet de clients, alimenté automatiquement par les réservations et les
// factures. Indépendant des deux : un client existe dès la première
// interaction, réservation ou facture, et reste réutilisable ensuite.
model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name    String
  email   String  @unique
  phone   String?
  address String?

  bookings Booking[]
  invoices Invoice[]
}

enum BookingStatus {
  NOUVELLE
  CONFIRMEE
  ARCHIVEE
}

model Booking {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  status         BookingStatus @default(NOUVELLE)

  // Coordonnées
  name           String
  email          String
  phone          String

  // Demande
  activityType   String
  preferredDate  DateTime
  timeSlot       String
  groupSize      Int
  level          String
  message        String?

  // Intégration Google Calendar
  googleEventId  String?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  invoices Invoice[]
}

// Ligne unique stockant les jetons OAuth du compte Google de la monitrice.
model CalendarConnection {
  id           String   @id @default("singleton")
  email        String?
  refreshToken String
  updatedAt    DateTime @updatedAt
}

// Ligne unique : informations légales de la monitrice, utilisées sur les factures.
model BusinessProfile {
  id           String   @id @default("singleton")
  legalName    String
  address      String
  siret        String
  legalForm    String // ex. "Entreprise Individuelle (micro-entreprise)"
  email        String
  phone        String?
  vatExempt    Boolean  @default(true) // franchise en base (art. 293 B du CGI)
  vatRate      Float    @default(0) // utilisé seulement si vatExempt = false
  iban         String?
  paymentTerms String   @default("Paiement à réception de facture. Moyens acceptés : virement, espèces, chèque.")
  updatedAt    DateTime @updatedAt
}

// Compteur séquentiel par année civile pour la numérotation légale des factures.
model InvoiceCounter {
  year        Int @id
  lastNumber  Int @default(0)
}

enum InvoiceStatus {
  EMISE
  PAYEE
  ANNULEE
}

model Invoice {
  id        String   @id @default(cuid())
  number    String   @unique // ex. "FACT-2026-0001"
  createdAt DateTime @default(now())

  issueDate   DateTime      @default(now())
  serviceDate DateTime
  dueDate     DateTime
  status      InvoiceStatus @default(EMISE)

  // Client (recopié au moment de l'émission — ne doit pas changer rétroactivement)
  clientName    String
  clientAddress String
  clientEmail   String

  // Prestation
  description String
  quantity    Float
  unitPrice   Decimal @db.Decimal(10, 2)
  vatRate     Float   @default(0)
  totalHT     Decimal @db.Decimal(10, 2)
  totalTVA    Decimal @db.Decimal(10, 2)
  totalTTC    Decimal @db.Decimal(10, 2)

  paymentTerms String

  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId String?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  sentAt DateTime?
}
