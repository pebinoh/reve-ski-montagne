generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Carnet de clients, alimenté automatiquement par les réservations et les
// factures. Indépendant des deux : un client existe dès la première
// interaction, réservation ou facture, et reste réutilisable ensuite.
model Client {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name    String
  email   String  @unique
  phone   String?
  address String?

  bookings Booking[]
  invoices Invoice[]
}

enum BookingStatus {
  NOUVELLE
  CONFIRMEE
  ARCHIVEE
}

model Booking {
  id             String        @id @default(cuid())
  createdAt      DateTime      @default(now())
  status         BookingStatus @default(NOUVELLE)

  // Coordonnées
  name           String
  email          String
  phone          String

  // Demande
  activityType   String
  preferredDate  DateTime
  timeSlot       String
  groupSize      Int
  level          String
  message        String?

  // Intégration Google Calendar
  googleEventId  String?

  // Email de confirmation envoyé au client
  confirmationSentAt DateTime?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  invoices Invoice[]
}

// Abonnement à une notification push (un par appareil/navigateur installé).
model PushSubscription {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  endpoint  String   @unique
  p256dh    String
  auth      String
}

// Ligne unique : tout le contenu éditable du site public (textes, images,
// liens Instagram), modifiable depuis /admin/content sans toucher au code.
model SiteContent {
  id        String   @id @default("singleton")
  updatedAt DateTime @updatedAt

  // Hero
  heroLabel        String @default("Sainte-Foy-Tarentaise · Savoie")
  heroTitle        String @default("Du rêve à la réalité, la montagne autrement.")
  heroImageDesktop String @default("/images/hero_ski.jpg")
  heroImageMobile  String @default("/images/hero_mobile.jpg")

  // Philosophie
  philosophyLabel String @default("L'esprit de la montagne")
  philosophyTitle String @default("Vivre la montagne autrement, loin des foules.")
  philosophyText  String @default("Basée à Sainte-Foy-Tarentaise, je vous guide à travers les itinéraires secrets de la vallée. Que vous cherchiez la poudreuse vierge ou une belle randonnée contemplative, mon objectif est de construire avec vous une aventure sur mesure, en toute sécurité.") @db.Text

  // Présentation ("Qui suis-je")
  presentationTitle  String @default("Évelyne, votre guide passionnée")
  presentationText   String @default("Amoureuse de la montagne et de ski, j'ai fait de ma passion mon métier. Installée au cœur de la Tarentaise, je connais chaque recoin de Sainte-Foy et navigue sur la Rosière, Tignes et Val d'Isère.\n\nMon approche : sécurité, plaisir et partage.\n\nQue vous soyez débutant en hors-piste ou expert en quête de pentes raides, je m'adapte à votre niveau et vos envies pour transformer votre journée de ski en un souvenir inoubliable.") @db.Text
  presentationImage  String @default("/images/portrait_evelyne.jpg")
  presentationBadges String @default("Diplômée d'État, Guide locale")

  // Activités (3 emplacements fixes)
  activity1Title String @default("Freeride & Hors-Piste")
  activity1Text  String @default("Découvrez les faces cachées de Sainte-Foy. La trace parfaite vous attend dans la poudreuse.")
  activity1Image String @default("/images/ski_rando_1.jpg")
  activity2Title String @default("Ski de Randonnée")
  activity2Text  String @default("Échappez aux remontées mécaniques. Le calme, l'effort et des paysages à couper le souffle.")
  activity2Image String @default("/images/ski_action_1.jpg")
  activity3Title String @default("Séjour en Itinérance")
  activity3Text  String @default("L'aventure sur plusieurs jours, de refuge en refuge. Une immersion totale pour déconnecter.")
  activity3Image String @default("/images/itinerance.jpg")

  // Séparateur (citation pleine page)
  separatorQuote        String @default("La montagne ne se consomme pas, elle se vit.")
  separatorImageDesktop String @default("/images/landscape_ski.jpg")
  separatorImageMobile  String @default("/images/landscape_mobile.jpg")

  // Instagram / Galerie
  instagramReel1      String @default("https://www.instagram.com/reel/DGQzWRoIfAc/")
  instagramReel2      String @default("https://www.instagram.com/reel/DFqXGWyofLS/")
  instagramReel3      String @default("https://www.instagram.com/reel/C5h_QNOooq3/")
  instagramProfileUrl String @default("https://www.instagram.com/reve_ski_montagne/")
  instagramHandle     String @default("@reve_ski_montagne")

  // Contact
  contactText    String @default("Faites votre demande de réservation ou contactez-moi directement pour discuter de votre projet.") @db.Text
  contactEmail   String @default("contact@reve-ski.com")
  contactPhone   String @default("+33 6 XX XX XX XX")
  contactAddress String @default("Sainte-Foy-Tarentaise, 73640")

  // Pied de page
  footerText String @default("Avec Évelyne, vivez la montagne autrement. Sécurité, pédagogie et bonne humeur sur les sommets de Sainte-Foy.") @db.Text
}

// Ligne unique stockant les jetons OAuth du compte Google de la monitrice.
model CalendarConnection {
  id           String   @id @default("singleton")
  email        String?
  refreshToken String
  updatedAt    DateTime @updatedAt
}

// Ligne unique : informations légales de la monitrice, utilisées sur les factures.
model BusinessProfile {
  id           String   @id @default("singleton")
  legalName    String
  address      String
  siret        String
  legalForm    String // ex. "Entreprise Individuelle (micro-entreprise)"
  email        String
  phone        String?
  vatExempt    Boolean  @default(true) // franchise en base (art. 293 B du CGI)
  vatRate      Float    @default(0) // utilisé seulement si vatExempt = false
  iban         String?
  paymentTerms String   @default("Paiement à réception de facture. Moyens acceptés : virement, espèces, chèque.")
  updatedAt    DateTime @updatedAt
}

// Compteur séquentiel par année civile pour la numérotation légale des factures.
model InvoiceCounter {
  year        Int @id
  lastNumber  Int @default(0)
}

enum InvoiceStatus {
  EMISE
  PAYEE
  ANNULEE
}

model Invoice {
  id        String   @id @default(cuid())
  number    String   @unique // ex. "FACT-2026-0001"
  createdAt DateTime @default(now())

  issueDate   DateTime      @default(now())
  serviceDate DateTime
  dueDate     DateTime
  status      InvoiceStatus @default(EMISE)

  // Client (recopié au moment de l'émission — ne doit pas changer rétroactivement)
  clientName    String
  clientAddress String
  clientEmail   String

  // Prestation
  description String
  quantity    Float
  unitPrice   Decimal @db.Decimal(10, 2)
  vatRate     Float   @default(0)
  totalHT     Decimal @db.Decimal(10, 2)
  totalTVA    Decimal @db.Decimal(10, 2)
  totalTTC    Decimal @db.Decimal(10, 2)

  paymentTerms String

  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId String?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  sentAt DateTime?
}
